# ── Backend (Railway) ──────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=repo_chunks

OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
LLM_MODEL=mistral:7b

RETRIEVAL_TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Path to the indexed repo inside the container
REPO_PATH=/repo

# Secret key to protect the /api/index endpoint
INDEX_API_KEY=change-me-in-production

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# ── CI/CD thresholds ──────────────────────────────────────────────────────────
HIT_RATE_THRESHOLD=0.80
MRR_THRESHOLD=0.60

# ── Frontend (Vercel) ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://your-backend.railway.app

# ── GitHub Actions secrets (set in repo Settings → Secrets) ──────────────────
# RAILWAY_WEBHOOK_URL  — Railway deploy webhook URL
# GITHUB_TOKEN         — auto-provided by Actions (for GHCR push)
